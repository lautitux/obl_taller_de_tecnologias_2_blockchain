{
  "name": "obligatorio",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "format:sol": "prettier --plugin prettier-plugin-solidity --write \"contracts/**/*.sol\"",
    "format:sol:check": "prettier --plugin prettier-plugin-solidity --check \"contracts/**/*.sol\"",
    "format": "prettier --write \"**/*.{sol,ts,tsx,js,mjs,cjs,html,css}\" --no-error-on-unmatched-pattern",
    "format:check": "prettier --check \"**/*.{sol,ts,tsx,js,mjs,cjs,html,css}\" --no-error-on-unmatched-pattern",
    "build": "hardhat build",
    "typecheck": "hardhat build && tsc --noEmit",
    "test:solidity": "hardhat test solidity",
    "test:typescript": "hardhat test nodejs",
    "test:coverage": "node .github/scripts/clean-coverage.mjs && hardhat test solidity --coverage && hardhat build && npm run coverage:check",
    "coverage:check": "node .github/scripts/check-coverage.mjs",
    "lint:sol": "forge lint --deny warnings",
    "lint:sol:advisory": "forge lint --severity info gas"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.1.9",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/node": "^22.20.5",
    "forge-std": "github:foundry-rs/forge-std#v1.16.2",
    "hardhat": "^3.21.0",
    "prettier": "^3.9.10",
    "prettier-plugin-solidity": "^2.4.1",
    "typescript": "~6.0.3",
    "viem": "^2.57.11"
  }
}
